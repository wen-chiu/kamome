    "about_export_diagnostics_note": {
      "comment": "About: diagnostics export for TestFlight testers (ADR 2026-09-24 (d)). Draft wording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A text file of Kamome's own log from this session — timings and counts, never a location. Nothing is sent: you choose where to share it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次開啟 App 以來 Kamome 自己的紀錄，存成文字檔：只有耗時和次數，不含任何位置。不會自動傳送，由你決定分享給誰。"
          }
        }
      }
    },

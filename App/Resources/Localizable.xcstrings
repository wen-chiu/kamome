    "acknowledgements_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source licences"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開放原始碼授權"
          }
        }
      }
    },
    "acknowledgements_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome is built with these open-source libraries. Their licences ask for their notices to be reproduced in full, so they are."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩使用了以下開放原始碼程式庫。它們的授權條款要求完整附上授權聲明，因此收錄於此。"
          }
        }
      }
    },
    "attribution_geoapify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powered by Geoapify"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Powered by Geoapify"
          }
        }
      }
    },
    "attribution_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps, terrain and routing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖、地形與路線"
          }
        }
      }
    },
    "attribution_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome asks Geoapify where the roads are, so a journey can be drawn along the roads you actually travelled instead of straight lines between points. Geoapify’s road data comes from OpenStreetMap. Terrain hillshading uses elevation data from AWS Open Data. Some sources are public domain (USGS SRTM, GMTED2010); others require attribution when their data appears in the film."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩會向 Geoapify 詢問道路的位置，讓旅程沿著你實際走過的路繪製，而不是在點與點之間畫直線。Geoapify 的道路資料來自 OpenStreetMap。地形使用來自 AWS Open Data 的高程資料。部分來源屬公有領域（USGS SRTM、GMTED2010）；其他來源的資料出現在影片中時需要標註。"
          }
        }
      }
    },
    "attribution_osm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map data © OpenStreetMap contributors"
          }
        },
        "zh-Hant": {

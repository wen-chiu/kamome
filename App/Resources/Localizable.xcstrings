    "import_albums_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole album becomes one trip. Check the dates: an album holding two separate journeys will be rebuilt as one, with a straight line between them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整本相簿會變成一趟旅程。請確認日期：若相簿裡是兩段不同的旅行，會被重建成同一趟，中間以直線相連。"
          }
        }
      }
    },

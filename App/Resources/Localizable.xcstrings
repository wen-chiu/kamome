    "access_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Journeys are found from where and when your photos were taken. Allow photo access in Settings and Kamome will look again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程是從相片的拍攝地點與時間找出來的。請在「設定」中允許相片存取，卡摸咩會再看一次。"
          }
        }
      }
    },

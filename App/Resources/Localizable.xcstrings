        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$d 段不是真實路線"
          }
        }
      }
    },
    "recap_routing_unreachable_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is wrong with the trip — we just can't reach the routing service right now, so those stretches are drawn dashed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程沒有問題，只是我們目前連不上路線服務，所以先畫成虛線。"

    },
    "record_sheet_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome follows your route by GPS while you travel. End the recording when you arrive, and the real route becomes your film."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出發後 Kamome 會用 GPS 記下你走過的路線。抵達時結束記錄，這條真實路線就能做成影片。"
          }
        }
      }
    },
    "record_trip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a trip"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄一趟旅程"
          }
        }
      }
    },
    "live_capture_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a new trip live"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時記錄新旅程"
          }
        }
      }
    },
    "make_film": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this a Film"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做成一部影片"
          }
        }
      }
    },
    "merge_with_previous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge with previous"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與前一個合併"
          }
        }
      }
    },
    "naming_stops_progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifying stops… %1$d of %2$d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在辨識停留地點… %1$d / %2$d"
          }
        }
      }
    },
    "nothing_found_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome looks for geotagged photos taken away from home. When you next travel, this is where the journey will appear — or import one by date or album."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩會尋找離家拍攝、帶有位置的相片。下次旅行後，旅程就會出現在這裡——也可以依日期或相簿匯入。"
          }
        }
      }
    },
    "nothing_found_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome can only see the photos you selected. Select more, or import a journey by date or album."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩只看得到你選取的相片。可以選取更多，或依日期、相簿匯入旅程。"
          }
        }
      }
    },
    "nothing_found_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No journeys yet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有找到旅程。"
          }
        }
      }
    },
    "priming_allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Background Recording"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許背景記錄"
          }
        }
      }
    },
    "priming_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Change to Always Allow\" so your route keeps recording with the screen locked. Kamome only ever tracks during a trip you started, and stops the moment you end it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇「永遠允許」，即使螢幕鎖定也能持續記錄路線。卡摸咩只在您啟動的旅程期間記錄，旅程結束立即停止。"
          }
        }
      }
    },
    "priming_later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時不要"
          }
        }
      }
    },
    "priming_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep recording with the screen off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕關閉也持續記錄"
          }
        }
      }
    },
    "privacy_control": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide what is sent by deciding what to import: a date range, or a single album."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你決定匯入什麼，就決定了會送出什麼：一段日期範圍，或是單一相簿。"
          }
        }
      }
    },
    "privacy_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What leaves this device"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些資料會離開這台裝置"
          }
        }
      }
    },
    "privacy_hop_direct": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They go straight from this device to Geoapify."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會從這台裝置直接送到 Geoapify。"
          }
        }
      }
    },
    "privacy_hop_relay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those positions pass through Kamome's relay, which holds the key, on to Geoapify."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些路線位置會先送到卡摸咩的中繼（金鑰放在那裡），再送到 Geoapify。"
          }
        }
      }
    },
    "privacy_imported_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each leg, Kamome sends that leg's positions: the centre of each stop and the positions of the photographs between them, thinned so that no two are closer than %1$.0f metres and capped at %2$lld per leg. They travel inside the web address of the request, which is the part of a request most likely to be written down along the way."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一段路程，卡摸咩會送出該段的位置：每個停留點的中心，以及其間相片的拍攝位置；相距不到 %1$.0f 公尺的點會被略過，每段最多 %2$lld 個點。這些座標放在請求的網址裡，而網址正是一次請求中最容易沿途被記錄下來的部分。"
          }
        }
      }
    },
    "privacy_imported_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips built from photos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相片建立的旅程"
          }
        }
      }
    },
    "privacy_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos, trips and films stay on this device. To draw the map, Kamome downloads map and terrain tiles for your trip's area from OpenFreeMap and Amazon, and asks Apple for stop names. To follow real roads, it sends the positions along your route."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的相片、旅程與影片都留在這台裝置。為了畫出地圖，卡摸咩會向 OpenFreeMap 與 Amazon 下載該區域的地圖與地形，並向 Apple 查詢停留點名稱；為了沿真實道路繪製，會送出路線上的位置。"
          }
        }
      }
    },
    "privacy_recorded_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The path your phone recorded is not sent to a routing service — it is already the route. When the film renders, the map tiles downloaded for its area reveal the route's geography, as described above. If a future version ever sends it, this notice will say so."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機記錄下來的路徑不會送到路線規劃服務——它本身就是路線。影片製作時，為其區域下載的地圖圖磚會透露路線的地理位置，如上所述。若日後的版本要送出它，本說明也會如實寫明。"
          }
        }
      }
    },
    "privacy_recorded_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips Kamome recorded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩記錄的旅程"
          }
        }
      }
    },
    "privacy_relay_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay is a small service on Cloudflare. It keeps no record of what it forwards — it counts requests, nothing more — and it forwards nothing that identifies your device, so Geoapify sees the relay rather than your phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼是放在 Cloudflare 上的小服務。它不保留任何一筆轉送內容的紀錄，只計算請求次數；也不會轉送任何足以識別你裝置的資料，因此 Geoapify 看到的是中繼，不是你的手機。"
          }
        }
      }
    },
    "privacy_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geoapify's own privacy policy says it keeps a request — its web address, its headers, your IP address and the time — for no longer than 24 hours when the request succeeds. Requests that fail are not covered by that sentence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 Geoapify 自己的隱私政策，成功的請求最多保留 24 小時，內容包含請求的網址、標頭、你的 IP 位址與時間。失敗的請求不在該句的涵蓋範圍內。"
          }
        }
      }
    },
    "privacy_share": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A finished film goes nowhere until you share it. When you do, it goes where you send it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的影片在你分享之前不會送到任何地方；你分享時，它就送往你選擇的去處。"
          }
        }
      }
    },
    "privacy_tiles_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Kamome renders a film, it downloads vector map tiles (z14) from OpenFreeMap and terrain tiles (z13) from Amazon for the area the trip covers. The sequence of tile requests follows the route. OpenFreeMap requires no account and no API key; both hosts see this device's IP address, the tile coordinates, a User-Agent string and the time of each request."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩製作影片時，會從 OpenFreeMap 下載該旅程所涵蓋區域的向量地圖圖磚（z14），以及從 Amazon 下載地形圖磚（z13）。圖磚請求的順序會沿路線進行。OpenFreeMap 不需要帳號也不需要 API 金鑰；兩個主機都看得到這台裝置的 IP 位址、圖磚座標、User-Agent 字串及每次請求的時間。"
          }
        }
      }
    },
    "privacy_tiles_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map tiles"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖圖磚"
          }
        }
      }
    },
    "provenance_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From photos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相片重建"
          }
        }
      }
    },
    "provenance_recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded live"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現場錄製"
          }
        }
      }
    },
    "provenance_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trip was reconstructed from your photos' place and time — not a recorded track."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這趟旅程根據相片的位置與時間重建，並非實際記錄的軌跡。"
          }
        }
      }
    },
    "provenance_recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時記錄"
          }
        }
      }
    },
    "recap_back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }

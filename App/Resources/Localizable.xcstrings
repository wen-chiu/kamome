    "recap_routing_budget_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trip ran past our time limit. What's already matched is saved — export again and it picks up from there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程太長，超出時間上限。畫好的路線已存，再輸出一次就會接著畫。"

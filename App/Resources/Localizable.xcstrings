    "recap_export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Recap"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

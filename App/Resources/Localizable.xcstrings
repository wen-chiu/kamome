    "recap_export_busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another film is rendering"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一部影片正在算圖"
          }
        }
      }
    },
    "recap_export_busy_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome renders one film at a time. Wait for the one in progress to finish, or cancel it on its own trip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩一次只算一部影片。請等目前這部完成，或到它所屬的旅程取消。"
          }
        }
      }
    },
    "recap_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出失敗"
          }
        }
      }
    },
    "recap_figure_label_day": {
      "comment": "The unit under the closing card's day count, for exactly one. Two keys rather than a plural variation: the number is drawn as a separate figure, and Xcode refuses a plural whose text does not contain it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DAY"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天"
          }
        }
      }
    },
    "recap_figure_label_days": {
      "comment": "The unit under the closing card's day count, for any other count. See recap_figure_label_day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DAYS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天"
          }
        }
      }
    },
    "recap_figure_label_km": {
      "comment": "The unit under the closing card's distance figure. Uppercase in English; it is a label in a row of three, never a sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KM"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公里"
          }
        }
      }
    },
    "recap_figure_label_stop": {
      "comment": "The unit under the closing card's stop count, for exactly one. See recap_figure_label_day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停留"
          }
        }
      }
    },
    "recap_figure_label_stops": {
      "comment": "The unit under the closing card's stop count, for any other count. See recap_figure_label_day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOPS"
          }
        },
        "zh-Hant": {

    "limited_photos_albums_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome only has access to the photos you selected, so most albums are hidden. Select more photos to see them, or import by date range instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩只能存取你選取的相片，因此大部分相簿不會出現。可以選取更多相片，或改用日期範圍匯入。"
          }
        }
      }
    },

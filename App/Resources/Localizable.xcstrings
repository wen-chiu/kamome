    "attribution_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome asks Geoapify where the roads are, so a journey can be drawn along the roads you actually travelled instead of straight lines between points. Geoapify's road data comes from OpenStreetMap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩會向 Geoapify 詢問道路的位置，讓旅程沿著你實際走過的路繪製，而不是在點與點之間畫直線。Geoapify 的道路資料來自 OpenStreetMap。"
          }
        }
      }
    },
    "attribution_osm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {

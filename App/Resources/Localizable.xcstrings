          "stringUnit": {
            "state": "translated",
            "value": "No photos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有照片"
          }
        }
      }
    },
    "stop_photos_row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos for the film"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑選影片的照片"
          }
        }
      }
    },
    "stop_photos_in_film": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld photos in the film"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片會用 %1$lld 張（共 %2$lld 張）"
          }
        }
      }
    },
    "stop_photos_not_in_film": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop isn’t in the film. Tap a photo, or turn the switch on, to put it in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一站不在影片裡。點一張照片，或打開上面的開關，就會放進去。"
          }
        }
      }
    },
    "stop_photos_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a photo to put it in the film or take it out — 1 to %lld per stop. Press and hold to never use a photo. ★ marks a Photos favourite; Kamome picks those first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點照片就能放進影片或拿掉，每站 1 到 %lld 張。長按可以設定永遠不用這張。★ 是「照片」App 裡的收藏，卡摸咩會優先挑選。"
          }
        }
      }
    },
    "stop_photos_include": {

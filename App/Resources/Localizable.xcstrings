        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以離開這個畫面 —— 只要卡摸咩還開著，影片就會繼續算圖，螢幕也會保持亮著直到完成。"
          }
        }
      }
    },
    "recap_routing_budget": {

    "welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos remember every journey — where you went, when, and how. Kamome finds them and turns each one into a film worth keeping."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的相片記得每一趟旅程——去了哪裡、什麼時候、怎麼去。卡摸咩會找出它們，把每一趟做成值得留下的影片。"
          }
        }
      }
    },
    "welcome_find": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find my journeys"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找出我的旅程"
          }
        }
      }
    },
    "welcome_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome reads where and when your photos were taken. Your photos never leave this device, and no journey is saved until you open it. To name each journey, Kamome asks Apple for the name of its main stop, which means sending that stop's coordinates."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩只讀取相片的拍攝地點與時間。相片不會離開這台裝置，打開之前也不會儲存任何旅程。為了替每趟旅程命名，卡摸咩會向 Apple 查詢其主要停留點的名稱，因此會送出該停留點的座標。"
          }
        }
      }
    },
    "welcome_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome already knows where you’ve been."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡摸咩已經知道你去過哪裡。"
          }
        }
      }
    },
    "recap_photos_preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing your photos…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備你的照片…"
          }
        }
      }
    },
    "recap_photos_downloading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading from iCloud"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從 iCloud 下載"
          }
        }
      }
    },
    "end_trip_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this trip?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要結束這趟旅程嗎？"
          }
        }
      }
    },
    "end_trip_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trip is saved and can be turned into a film. An ended trip can't be continued — if you're only stopping for the night, keep recording."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程會儲存下來，可以做成影片。結束後就無法接續錄製；如果只是晚上休息，繼續錄製就好。"
          }
        }
      }
    },
    "end_trip_keep_recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Recording"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續錄製"
          }
        }
      }
    },
    "recording_resumed_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome was closed, so recording picked up again by itself. About %@ has no track."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamome 曾被關閉，已自動接續錄製。其間約 %@ 沒有軌跡。"
          }
        }
      }
    },
    "recording_resumed_dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "trip_merge_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge Trips…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併旅程…"
          }
        }
      }
    },
    "trip_merge_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge Trips"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併旅程"
          }
        }
      }
    },
    "trip_merge_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併"
          }
        }
      }
    },
    "trip_merge_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no other finished trips to merge with."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有其他已結束的旅程可以合併。"
          }
        }
      }
    },
    "trip_merge_overlap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlaps this trip — can't be merged"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和這趟時間重疊，無法合併"
          }
        }
      }
    },
    "trip_merge_explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the trips to merge with this one. They become one trip and one film; films already made are kept. Road between the trips that nothing recorded is shown as inferred, the way photo-rebuilt legs are. If any part was rebuilt from photos, the whole trip is marked that way. Merging can't be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要和這趟合併的旅程。合併後會變成一趟旅程、做成一支影片，已經做好的影片會保留。兩段之間沒有記錄到的路，會和照片重建的路段一樣以推測方式呈現；只要有一段是照片重建的，整趟就標示為照片重建。合併後無法復原。"
          }
        }
      }
    },
    "trip_merge_busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A film is being exported from one of these trips. Merge after it finishes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一趟旅程正在匯出影片，請等匯出完成再合併。"
          }
        }
      }
    },
    "trip_merge_failed_overlap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two of the picked trips overlap in time, so they can't be merged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取的旅程之間有時間重疊，無法合併。"
          }
        }
      }
    },
    "trip_merge_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These trips couldn't be merged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法合併這些旅程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}

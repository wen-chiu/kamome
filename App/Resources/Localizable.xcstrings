    "recap_photos_missing_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d of %2$d photos couldn’t be loaded, so those stops show blank cards. If they’re in iCloud, check your connection and export again. The route itself is unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$d 張（共 %2$d 張）無法載入，這些停留點會顯示空白卡片。如果它們在 iCloud，請確認網路連線後再重新輸出。路線本身不受影響。"
          }
        }
      }
    },

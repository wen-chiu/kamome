      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no road joining these places. We record journeys honestly: no road, no solid line."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些地方之間沒有道路相連 —— 我們誠實記錄旅程路線，沒有路就不會是實線。"
          }
        }
      }
    },

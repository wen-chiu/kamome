# Turn the confusing failure into a clear one.
#
# A shell defaulting to Node 17 (x64, under Rosetta) resolved an Intel `workerd`
# into the shared npx cache, and the deploy then died with "You installed workerd
# on another platform than the one you're currently using" — which names neither
# Node nor the version. wrangler 4.127.1 declares `engines: node >=22.0.0`, so
# with this flag `npm ci` refuses up front and says so.
engine-strict=true

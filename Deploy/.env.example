# Copy to Deploy/.env and edit. Everything has a working local default, so an
# empty .env is a valid local setup.

# Where built artifacts live. Gigabytes — never inside the repo.
# KAMOME_DATA_DIR=/Users/you/kamome-osrm

# ── Local (home Wi-Fi) ───────────────────────────────────────────────────────
# 0.0.0.0 so a phone on the same network can reach the Mac. Use 127.0.0.1 to
# keep it to this machine only (the simulator can still reach it).
# 5100, not OSRM's conventional 5000: macOS AirPlay Receiver (ControlCenter)
# listens on 5000, so the container cannot bind it. Turn AirPlay Receiver off in
# System Settings → General → AirDrop & Handoff if you want 5000 back.
OSRM_BIND=0.0.0.0
OSRM_PORT=5100

# ── VPS (`docker compose --profile public up`) ───────────────────────────────
# Publish OSRM only to localhost and let Caddy be the one thing facing outward.
# OSRM_BIND=127.0.0.1
# OSRM_DOMAIN=osrm.example.com

# Planned, not yet active — see the note at the foot of Deploy/Caddyfile and
# "VPS migration — deferred security work" in Docs/handoff-P3.5.md. The app does
# not send this header yet; turning it on alone breaks all routing.
# KAMOME_OSRM_TOKEN=

# OSRM request caps. The defaults are generous for one dogfooder.
# OSRM_MAX_MATCHING_SIZE=1000
# OSRM_MAX_VIAROUTE_SIZE=500
